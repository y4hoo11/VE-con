datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 車両のステータス定義
enum VehicleStatus {
  IDLE
  MOVING
  CHARGING
  ERROR
  MAINTENANCE
}

// ログレベル定義
enum LogLevel {
  INFO
  WARN
  ERROR
}

// タスクモデル
model Task {
  id                String    @id @default(uuid())
  code              String    @unique @default(uuid())
  name              String
  progress          Int       @default(0)
  quantity          Int       @default(1)
  priority          Int       @default(3)
  startLocation     String?
  targetLocation    String?
  
  // 車両（AGV）とのリレーション
  assignedVehicleId String?
  assignedVehicle   Vehicle?  @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

  createdAt         DateTime  @default(now())
  dueDate           DateTime?
}

// 車両 (AGV) モデル
model Vehicle {
  id            String        @id // 例: "AGV-01"
  name          String?
  status        VehicleStatus @default(IDLE)
  batteryLevel  Int           @default(100)
  currentX      Float         @default(0.0)
  currentY      Float         @default(0.0)
  currentTheta  Float?
  lastHeartbeat DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  logs  VehicleLog[]
  tasks Task[]
}

// 車両ログモデル
model VehicleLog {
  id        Int      @id @default(autoincrement())
  vehicleId String
  logLevel  LogLevel @default(INFO)
  message   String
  details   Json?
  timestamp DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// ステータス Enum
enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// 設定カテゴリ Enum
enum SettingCategory {
  GENERAL
  DISPATCH
  SAFETY
  NETWORK
}

// タスク履歴モデル
model TaskHistory {
  id        String     @id @default(uuid())
  taskId    String
  vehicleId String?
  status    TaskStatus
  message   String?
  timestamp DateTime   @default(now())

  @@map("task_histories")
}

// システム設定モデル
model SystemSetting {
  id          String          @id @default(uuid())
  key         String          @unique
  value       String
  category    SettingCategory @default(GENERAL)
  description String?
  updatedAt   DateTime        @updatedAt

  @@map("system_settings")
}